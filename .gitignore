# 1. Reset dulu .gitignore kamu ke versi clean
cat > .gitignore << 'EOF'
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Frontend
frontend/node_modules
frontend/.next
frontend/out

# Python ETL - JANGAN DI PUSH
etl/venv/
venv/
etl/raw_data/
etl/cleaned_data/
**/incoming/
**/processed/
__pycache__/
*.pyc
*.pyo
*.pkl
.env
etl/service-account.json
etl/credentials.json
*.xlsx
*.xls
*.csv
!**/sample*.xlsx
EOF

cat .gitignore